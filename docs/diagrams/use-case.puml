@startuml use-case
!include include/style.iuml
title Use cases
left to right direction

actor "API client" as Client
actor "API developer" as Dev
actor "Translator" as Tr
actor "CI pipeline" as CI <<system>>

rectangle "fastapi-locale" {
  usecase "UC-01\nReceive a response in\nthe preferred language" as UC01
  usecase "UC-02\nReceive validation errors in\nthe preferred language" as UC02
  usecase "UC-08\nRead API documentation\nin a chosen language" as UC08 #EEEEEE
  usecase "Resolve the\nrequest locale" as RES
  usecase "UC-05\nUse a signed-in user's\nsaved language" as UC05
  usecase "UC-03\nTranslate a message\nin application code" as UC03
  usecase "UC-04\nPut translatable text in a\nmodel or HTTPException" as UC04
  usecase "UC-07\nTest routes under\na fixed locale" as UC07
  usecase "UC-06\nExtract, translate and\ncompile catalogs" as UC06
  usecase "UC-09\nVerify catalogs\nare up to date" as UC09
}

Client --> UC01
Client --> UC02
Client --> UC08
UC01 ..> RES : <<include>>
UC02 ..> RES : <<include>>
UC08 ..> RES : <<include>>
UC05 .up.> RES : <<extend>>

UC03 <-- Dev
UC04 <-- Dev
UC05 <-- Dev
UC07 <-- Dev
UC06 <-- Dev
UC06 <-- Tr
UC09 <-- CI

legend right
  Grey use case: planned after the first release
endlegend
@enduml
