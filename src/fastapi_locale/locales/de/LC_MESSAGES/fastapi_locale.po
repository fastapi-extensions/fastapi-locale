msgctxt "arguments_type"
msgid "Arguments must be a tuple, list or a dictionary"
msgstr "Argumente müssen ein Tupel, eine Liste oder ein Dictionary sein"

#, python-brace-format
msgctxt "assertion_error"
msgid "Assertion failed, {error}"
msgstr "Assertion fehlgeschlagen, {error}"

#, python-brace-format
msgctxt "needs_python_object"
msgid "Cannot check `{method_name}` when validating from json, use a JsonOrPython validator instead"
msgstr ""
"`{method_name}` kann bei der Validierung von JSON nicht geprüft werden, verwenden Sie stattdessen"
" einen JsonOrPython-Validator"

