msgctxt "bytes_too_short"
msgid "Data should have at least {min_length} byte"
msgid_plural "Data should have at least {min_length} bytes"
msgstr[0] "Daten müssen mindestens {min_length} Byte haben"
msgstr[1] "Daten müssen mindestens {min_length} Bytes haben"

