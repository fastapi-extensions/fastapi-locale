msgctxt "arguments_type"
msgid "Arguments must be a tuple, list or a dictionary"
msgstr "Los argumentos deben ser una tupla, una lista o un diccionario"

#, python-brace-format
msgctxt "assertion_error"
msgid "Assertion failed, {error}"
msgstr "Falló la aserción, {error}"

#, python-brace-format
msgctxt "needs_python_object"
msgid "Cannot check `{method_name}` when validating from json, use a JsonOrPython validator instead"
msgstr "No se puede comprobar `{method_name}` al validar desde JSON; use un validador JsonOrPython"

msgctxt "openapi"
msgid "Context"
msgstr "Contexto"

#, python-brace-format
msgctxt "bytes_invalid_encoding"
msgid "Data should be valid {encoding}: {encoding_error}"
msgstr "Los datos deben ser {encoding} válido: {encoding_error}"

#, python-brace-format
msgctxt "bytes_too_short"
msgid "Data should have at least {min_length} byte"
msgid_plural "Data should have at least {min_length} bytes"
msgstr[0] "Los datos deben tener al menos {min_length} byte"
msgstr[1] "Los datos deben tener al menos {min_length} bytes"

#, python-brace-format
msgctxt "bytes_too_long"
msgid "Data should have at most {max_length} byte"
msgid_plural "Data should have at most {max_length} bytes"
msgstr[0] "Los datos deben tener como máximo {max_length} byte"
msgstr[1] "Los datos deben tener como máximo {max_length} bytes"

msgctxt "date_future"
msgid "Date should be in the future"
msgstr "La fecha debe estar en el futuro"

msgctxt "date_past"
msgid "Date should be in the past"
msgstr "La fecha debe estar en el pasado"

msgctxt "date_from_datetime_inexact"
msgid "Datetimes provided to dates should have zero time - e.g. be exact dates"
msgstr ""
"Las fechas y horas proporcionadas como fecha deben tener la hora a cero, es decir, ser fechas "
"exactas"

msgctxt "decimal_type"
msgid "Decimal input should be an integer, float, string or Decimal object"
msgstr "La entrada decimal debe ser un entero, un número de coma flotante, una cadena o un objeto Decimal"

#, python-brace-format
msgctxt "decimal_max_places"
msgid "Decimal input should have no more than {decimal_places} decimal place"
msgid_plural "Decimal input should have no more than {decimal_places} decimal places"
msgstr[0] "La entrada decimal no debe tener más de {decimal_places} decimal"
msgstr[1] "La entrada decimal no debe tener más de {decimal_places} decimales"

#, python-brace-format
msgctxt "decimal_max_digits"
msgid "Decimal input should have no more than {max_digits} digit in total"
msgid_plural "Decimal input should have no more than {max_digits} digits in total"
msgstr[0] "La entrada decimal no debe tener más de {max_digits} dígito en total"
msgstr[1] "La entrada decimal no debe tener más de {max_digits} dígitos en total"

#, python-brace-format
msgctxt "decimal_whole_digits"
msgid "Decimal input should have no more than {whole_digits} digit before the decimal point"
msgid_plural "Decimal input should have no more than {whole_digits} digits before the decimal point"
msgstr[0] "La entrada decimal no debe tener más de {whole_digits} dígito antes del separador decimal"
msgstr[1] "La entrada decimal no debe tener más de {whole_digits} dígitos antes del separador decimal"

msgctxt "openapi"
msgid "Detail"
msgstr "Detalle"

msgctxt "openapi"
msgid "Error Type"
msgstr "Tipo de error"

#, python-brace-format
msgctxt "get_attribute_error"
msgid "Error extracting attribute: {error}"
msgstr "Error al extraer el atributo: {error}"

#, python-brace-format
msgctxt "iteration_error"
msgid "Error iterating over object, error: {error}"
msgstr "Error al iterar sobre el objeto, error: {error}"

msgctxt "extra_forbidden"
msgid "Extra inputs are not permitted"
msgstr "No se permiten entradas adicionales"

msgctxt "frozen_field"
msgid "Field is frozen"
msgstr "El campo es inmutable"

msgctxt "missing"
msgid "Field required"
msgstr "Campo obligatorio"

msgctxt "multiple_argument_values"
msgid "Got multiple values for argument"
msgstr "Se recibieron varios valores para el argumento"

