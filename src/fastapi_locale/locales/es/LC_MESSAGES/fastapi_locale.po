msgstr "La entrada debe ser un booleano válido; no se pudo interpretar la entrada"

msgctxt "bytes_type"
msgid "Input should be a valid bytes"
msgstr "La entrada debe ser bytes válidos"

msgctxt "complex_str_parsing"
msgid ""
"Input should be a valid complex string following the rules at "
"https://docs.python.org/3/library/functions.html#complex"
msgstr ""
"La entrada debe ser una cadena compleja válida según las reglas de "
"https://docs.python.org/3/library/functions.html#complex"

msgctxt "date_type"
msgid "Input should be a valid date"
msgstr "La entrada debe ser una fecha válida"

#, python-brace-format
msgctxt "date_parsing"
msgid "Input should be a valid date in the format YYYY-MM-DD, {error}"
msgstr "La entrada debe ser una fecha válida con el formato AAAA-MM-DD, {error}"

#, python-brace-format
msgctxt "date_from_datetime_parsing"
msgid "Input should be a valid date or datetime, {error}"
msgstr "La entrada debe ser una fecha o fecha y hora válida, {error}"

msgctxt "datetime_type"
