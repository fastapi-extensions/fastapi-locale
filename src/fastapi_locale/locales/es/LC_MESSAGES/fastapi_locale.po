msgctxt "datetime_parsing"
msgid "Input should be a valid datetime, {error}"
msgstr "La entrada debe ser una fecha y hora válida, {error}"

msgctxt "decimal_parsing"
msgid "Input should be a valid decimal"
msgstr "La entrada debe ser un decimal válido"

