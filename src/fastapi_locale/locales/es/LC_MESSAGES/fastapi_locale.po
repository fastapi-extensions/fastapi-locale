msgstr "La entrada debe ser un diccionario válido o un objeto del que se puedan extraer campos"

msgctxt "frozen_set_type"
msgid "Input should be a valid frozenset"
msgstr "La entrada debe ser un frozenset válido"

msgctxt "int_type"
msgid "Input should be a valid integer"
msgstr "La entrada debe ser un número entero válido"

