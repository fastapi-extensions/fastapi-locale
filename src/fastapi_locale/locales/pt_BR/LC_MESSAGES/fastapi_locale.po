msgstr "Falha na asserção, {error}"

#, python-brace-format
msgctxt "needs_python_object"
msgid "Cannot check `{method_name}` when validating from json, use a JsonOrPython validator instead"
msgstr ""
"Não é possível verificar `{method_name}` ao validar a partir de JSON; use um validador "
"JsonOrPython"

