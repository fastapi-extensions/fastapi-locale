msgctxt "arguments_type"
msgid "Arguments must be a tuple, list or a dictionary"
msgstr "Les arguments doivent être un tuple, une liste ou un dictionnaire"

#, python-brace-format
msgctxt "assertion_error"
msgid "Assertion failed, {error}"
msgstr "Échec de l'assertion, {error}"

#, python-brace-format
msgctxt "needs_python_object"
msgid "Cannot check `{method_name}` when validating from json, use a JsonOrPython validator instead"
msgstr ""
"Impossible de vérifier `{method_name}` lors de la validation depuis JSON ; utilisez plutôt un "
"validateur JsonOrPython"

msgctxt "openapi"
msgid "Context"
msgstr "Contexte"

#, python-brace-format
msgctxt "bytes_invalid_encoding"
msgid "Data should be valid {encoding}: {encoding_error}"
msgstr "Les données doivent être du {encoding} valide : {encoding_error}"

#, python-brace-format
msgctxt "bytes_too_short"
msgid "Data should have at least {min_length} byte"
msgid_plural "Data should have at least {min_length} bytes"
msgstr[0] "Les données doivent contenir au moins {min_length} octet"
msgstr[1] "Les données doivent contenir au moins {min_length} octets"

#, python-brace-format
msgctxt "bytes_too_long"
msgid "Data should have at most {max_length} byte"
msgid_plural "Data should have at most {max_length} bytes"
msgstr[0] "Les données doivent contenir au plus {max_length} octet"
msgstr[1] "Les données doivent contenir au plus {max_length} octets"

msgctxt "date_future"
msgid "Date should be in the future"
msgstr "La date doit être dans le futur"

msgctxt "date_past"
msgid "Date should be in the past"
msgstr "La date doit être dans le passé"

msgctxt "date_from_datetime_inexact"
msgid "Datetimes provided to dates should have zero time - e.g. be exact dates"
msgstr ""
"Les dates et heures fournies comme dates doivent avoir une heure nulle, c'est-à-dire être des "
"dates exactes"

msgctxt "decimal_type"
msgid "Decimal input should be an integer, float, string or Decimal object"
msgstr "L'entrée décimale doit être un entier, un flottant, une chaîne ou un objet Decimal"

#, python-brace-format
msgctxt "decimal_max_places"
msgid "Decimal input should have no more than {decimal_places} decimal place"
msgid_plural "Decimal input should have no more than {decimal_places} decimal places"
msgstr[0] "L'entrée décimale ne doit pas avoir plus de {decimal_places} décimale"
msgstr[1] "L'entrée décimale ne doit pas avoir plus de {decimal_places} décimales"

#, python-brace-format
msgctxt "decimal_max_digits"
msgid "Decimal input should have no more than {max_digits} digit in total"
msgid_plural "Decimal input should have no more than {max_digits} digits in total"
msgstr[0] "L'entrée décimale ne doit pas avoir plus de {max_digits} chiffre au total"
msgstr[1] "L'entrée décimale ne doit pas avoir plus de {max_digits} chiffres au total"

#, python-brace-format
msgctxt "decimal_whole_digits"
msgid "Decimal input should have no more than {whole_digits} digit before the decimal point"
msgid_plural "Decimal input should have no more than {whole_digits} digits before the decimal point"
msgstr[0] "L'entrée décimale ne doit pas avoir plus de {whole_digits} chiffre avant la virgule"
msgstr[1] "L'entrée décimale ne doit pas avoir plus de {whole_digits} chiffres avant la virgule"

